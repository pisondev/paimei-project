# Salin jadi `.env`, lalu isi dengan nilai sungguhan. `.env` tidak ikut ter-commit.
#
# Password database dipakai oleh docker-compose.yaml saat menyiapkan container Postgres.
# Kalau database SUDAH ada isinya (folder db-data terisi), mengubah nilai di sini TIDAK
# mengganti password yang tersimpan — Postgres hanya membacanya saat inisialisasi pertama.
# Untuk mengganti password database yang sudah jalan:
#   docker exec -it paimei-db-container psql -U user_paimei -d paimei_db \
#     -c "ALTER USER user_paimei PASSWORD 'password-baru'"
# lalu perbarui nilai di sini DAN di paimei-api/.env (DB_PASSWORD), baru restart.
POSTGRES_PASSWORD=ganti-dengan-password-acak-yang-panjang
